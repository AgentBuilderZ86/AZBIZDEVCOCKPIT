# Copier vers .env.local et renseigner les vraies valeurs (jamais committer .env.local).
# En production : définir ces variables dans Netlify (Site settings → Environment variables).

# --- Notion (source de vérité) ---
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_COMPTES=""
NOTION_DB_CONTACTS=""
NOTION_DB_OPPORTUNITES=""
NOTION_DB_SIGNAUX=""
NOTION_DB_OFFRES=""
NOTION_DB_OBJECTIFS=""

# --- Enrichissement (optionnel) ---
APOLLO_API_KEY=
# Clé Hunter.io (Domain Search) — contacts/emails (optionnel).
HUNTER_API_KEY=
EXPLORIUM_API_KEY=
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cron (Phase 4) ---
# Secret partagé protégeant la route /api/cron/refresh.
CRON_SECRET=change-me-cron-secret
