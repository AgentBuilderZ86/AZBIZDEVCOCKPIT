# Copier vers .env.local et renseigner les vraies valeurs (jamais committer .env.local).
# En production : définir ces variables dans Netlify (Site settings → Environment variables).
# Ce fichier ne contient QUE des placeholders vides (template).

# --- Notion (source de vérité) ---
NOTION_TOKEN=
NOTION_DB_COMPTES=
NOTION_DB_CONTACTS=
NOTION_DB_OPPORTUNITES=
NOTION_DB_SIGNAUX=
NOTION_DB_OFFRES=
NOTION_DB_OBJECTIFS=

# --- Enrichissement (optionnel) ---
APOLLO_API_KEY=
HUNTER_API_KEY=
EXPLORIUM_API_KEY=
ANTHROPIC_API_KEY=

# --- Notifications Slack (optionnel) ---
# Incoming Webhook URL (https://api.slack.com/messaging/webhooks)
# Si absent : alertes désactivées silencieusement.
SLACK_WEBHOOK_URL=

# --- Authentification (Clerk) — OBLIGATOIRE en production ---
# Créer une application sur https://dashboard.clerk.com puis copier les clés.
# Sans ces clés, l'app est verrouillée (état sûr par défaut).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Page de connexion personnalisée.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Allowlist e-mail (défense en profondeur). Séparer par des virgules.
# Activer aussi l'allowlist côté Clerk (Restrictions) + désactiver l'inscription publique.
# Pour que le filtre e-mail s'applique aussi dans le middleware, ajouter un JWT template
# Clerk contenant {"email": "{{user.primary_email_address}}"}.
ALLOWED_EMAILS=azriouil.az@gmail.com

# --- Gouvernance des données (optionnel) ---
# Mettre à 1 pour ne JAMAIS envoyer de données client à Apollo/Hunter/Explorium.
DISABLE_EXTERNAL_ENRICHMENT=
# Mettre à 1 pour imposer la CSP (sinon Report-Only). Activer après validation visuelle.
CSP_ENFORCE=

# --- Rate-limiting robuste (optionnel) ---
# Sans ces variables : repli best-effort en mémoire (par instance).
# Avec : quota global partagé via Upstash (https://upstash.com → Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron (Phase 4) ---
CRON_SECRET=

# --- Intelligence — Sprint S0 (Postgres + pgvector, optionnel) ---
# Sans DATABASE_URL : Phases 0–5 inchangées (Notion seul).
DATABASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=
# Clé Voyage AI (https://dash.voyageai.com) ou OpenAI text-embedding-3-large
# Sans carte sur Voyage : 3 req/min, 10K tokens/min — pour gros PDF sur Netlify :
# VOYAGE_EMBED_BATCH_SIZE=3
# VOYAGE_EMBED_BATCH_DELAY_MS=21000
